# Production example — DO NOT commit real secrets.
# Copy values into Render/Vercel environment settings.

APP_NAME=FinAI Backend
APP_VERSION=0.1.0
APP_ENV=production
DEBUG=false

# MongoDB Atlas connection string (set in Render env; never commit a real URI).
# The prod validator rejects empty URIs and mongodb://localhost — the app fails
# fast at startup if MONGODB_URI is missing or points at localhost.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Leave empty to auto-select "fincompass" in production.
MONGODB_DATABASE=

# Legacy PostgreSQL URL — KEPT ONLY for Alembic history and the PG→Mongo
# data-migration script. The runtime backend is MongoDB.
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/finai

REDIS_URL=redis://:PASSWORD@HOST:6379/0

JWT_SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_EXPIRE_DAYS_REMEMBER=90

COOKIE_SECURE=true
# Required: the frontend (Vercel) and backend (Render) are cross-site, so the
# refresh-token cookie must be SameSite=None for the browser to send it.
COOKIE_SAMESITE=none

# LLM provider (Groq by default; OpenAI-compatible). Set LLM_API_KEY in the
# deployment environment only — never commit a real key.
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=60
LLM_READ_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# Must be "smtp" in production. If left "console", emails are NOT delivered and
# bodies are never logged (security guard in app/services/email/providers.py).
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

CORS_ORIGINS=https://fincompass-three.vercel.app

DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata

LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_LIMIT=20
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_CHAT_LIMIT=30
RATE_LIMIT_CHAT_WINDOW=60
RATE_LIMIT_ML_LIMIT=60
RATE_LIMIT_ML_WINDOW=60
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
