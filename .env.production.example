# Production example — DO NOT commit real secrets.
# Copy values into Render/Vercel environment settings.

APP_NAME=FinAI Backend
APP_VERSION=0.1.0
APP_ENV=production
DEBUG=false

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/finai
REDIS_URL=redis://:PASSWORD@HOST:6379/0

JWT_SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_EXPIRE_DAYS_REMEMBER=90

COOKIE_SECURE=true

LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

CORS_ORIGINS=https://your-app.vercel.app

DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata

LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
