APP_NAME=FinAI Backend
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# Local MongoDB (default) — mongod on localhost, no Docker required
MONGODB_URI=mongodb://localhost:27017
# Leave empty to auto-select: "fincompass" (production) else "fincompass_dev"
MONGODB_DATABASE=

# Legacy PostgreSQL URL — KEPT ONLY for Alembic history and the PG→Mongo
# data-migration script. The runtime backend is MongoDB.
# DATABASE_URL=sqlite+aiosqlite:///./finai_dev.sqlite

REDIS_URL=redis://localhost:6379/0

# Leave blank for local dev; production REQUIRES a strong random secret
# (APP_ENV=production fails to start with a weak/missing JWT_SECRET_KEY).
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_EXPIRE_DAYS_REMEMBER=90

# "lax" for local dev. Must be "none" in production (cross-site cookie between
# Vercel and Render), with COOKIE_SECURE=true. Leave blank to auto-select:
# "lax" in dev, "none" in production.
COOKIE_SECURE=false
COOKIE_SAMESITE=

# LLM provider (Groq by default; OpenAI-compatible). LLM_API_KEY must come from
# your local .env only — never commit a real key.
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=60
LLM_READ_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# Voice STT provider: Sarvam AI (server-side only; never use NEXT_PUBLIC_*).
# Voice input requires SARVAM_API_KEY. Do not commit a real key.
SARVAM_API_KEY=
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_TIMEOUT_SECONDS=30

# Voice TTS provider: Google Cloud Text-to-Speech (server-side only).
# Use Application Default Credentials locally or set a secure service-account
# file path. Do not commit credential files.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
VOICE_MAX_AUDIO_SIZE=10485760
VOICE_MAX_DURATION_SECONDS=20
VOICE_TTS_MAX_CHARACTERS=4000
VOICE_TIMEOUT_SECONDS=30

# console (dev) | smtp (production). Never leave console in production — reset
# tokens would be skipped (see providers.py) and emails never delivered.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@fincompass.example.com
FRONTEND_URL=http://localhost:3000

# Comma-separated frontend origins (Next.js dev on 3000, Vite dev on 5173,
# and the production Vercel deployment).
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://127.0.0.1:3100,http://localhost:5173,http://127.0.0.1:5173,https://fincompass-three.vercel.app

DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata

LOG_LEVEL=INFO

# Disable rate limiting locally if Redis is not running
RATE_LIMIT_ENABLED=false
RATE_LIMIT_CHAT_LIMIT=30
RATE_LIMIT_CHAT_WINDOW=60
RATE_LIMIT_ML_LIMIT=60
RATE_LIMIT_ML_WINDOW=60
RATE_LIMIT_VOICE_LIMIT=30
RATE_LIMIT_VOICE_WINDOW=60
# Per-endpoint auth limits. Plain *_LIMIT/*_WINDOW are per-client-IP buckets;
# *_EMAIL_* are per-email buckets applied only when the request carries an email.
RATE_LIMIT_REGISTER_LIMIT=5
RATE_LIMIT_REGISTER_WINDOW=900
RATE_LIMIT_REGISTER_EMAIL_LIMIT=3
RATE_LIMIT_REGISTER_EMAIL_WINDOW=900
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_LOGIN_EMAIL_LIMIT=5
RATE_LIMIT_LOGIN_EMAIL_WINDOW=300
RATE_LIMIT_REFRESH_LIMIT=30
RATE_LIMIT_REFRESH_WINDOW=60
RATE_LIMIT_FORGOT_LIMIT=5
RATE_LIMIT_FORGOT_WINDOW=3600
RATE_LIMIT_FORGOT_EMAIL_LIMIT=3
RATE_LIMIT_FORGOT_EMAIL_WINDOW=3600
RATE_LIMIT_RESET_LIMIT=5
RATE_LIMIT_RESET_WINDOW=3600

CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
