APP_NAME=FinAI Backend
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# Local SQLite (default) — no Docker required
DATABASE_URL=sqlite+aiosqlite:///./finai_dev.sqlite

# Docker / PostgreSQL local (uncomment to use)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finai

REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_EXPIRE_DAYS_REMEMBER=90

COOKIE_SECURE=false

LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

CORS_ORIGINS=http://localhost:3000

DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata

LOG_LEVEL=INFO

# Disable rate limiting locally if Redis is not running
RATE_LIMIT_ENABLED=false

CACHE_ENABLED=true
CACHE_TTL_SECONDS=300

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
