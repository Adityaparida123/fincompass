APP_NAME=FinAI Backend
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# Local MongoDB (default) — mongod on localhost, no Docker required
MONGODB_URI=mongodb://localhost:27017
# Leave empty to auto-select: "fincompass" (production) else "fincompass_dev"
MONGODB_DATABASE=

# Legacy PostgreSQL URL — KEPT ONLY for Alembic history and the PG→Mongo
# data-migration script. The runtime backend is MongoDB.
# DATABASE_URL=sqlite+aiosqlite:///./finai_dev.sqlite

REDIS_URL=redis://localhost:6379/0

# Leave blank for local dev; production REQUIRES a strong random secret
# (APP_ENV=production fails to start with a weak/missing JWT_SECRET_KEY).
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_EXPIRE_DAYS_REMEMBER=90

# "lax" for local dev. Must be "none" in production (cross-site cookie between
# Vercel and Render), with COOKIE_SECURE=true. Leave blank to auto-select:
# "lax" in dev, "none" in production.
COOKIE_SECURE=false
COOKIE_SAMESITE=

# LLM provider (Groq by default; OpenAI-compatible). LLM_API_KEY must come from
# your local .env only — never commit a real key.
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=60
LLM_READ_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# console (dev) | smtp (production). Never leave console in production — reset
# tokens would be skipped (see providers.py) and emails never delivered.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

CORS_ORIGINS=http://localhost:3000

DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata

LOG_LEVEL=INFO

# Disable rate limiting locally if Redis is not running
RATE_LIMIT_ENABLED=false
RATE_LIMIT_AUTH_LIMIT=20
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_CHAT_LIMIT=30
RATE_LIMIT_CHAT_WINDOW=60
RATE_LIMIT_ML_LIMIT=60
RATE_LIMIT_ML_WINDOW=60

CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
